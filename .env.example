# The classifier: which model decides between the routes, and where it runs.
OPENAI_BASE_URL=https://router-gateway.internal/v1
OPENAI_API_KEY=router-key
ROUTER_MODEL=small-routing-model

# The "fast" route: its own gateway and its own credential.
FAST_BASE_URL=https://fast-gateway.internal/v1
FAST_API_KEY=fast-key
FAST_MODEL=luna

# The "powerful" route: its own gateway and its own credential.
POWERFUL_BASE_URL=https://powerful-gateway.internal/v1
POWERFUL_API_KEY=powerful-key
POWERFUL_MODEL=sol

# Optional: classifier backend, "openai" (default) or "laya".
CLASSIFIER=openai

# Optional: which Laya checkpoint the "laya" backend loads. "multilingual"
# (default) resolves to convaiinnovations/laya-multilingual. Also available:
# "english" and "typed-decisions".
LAYA_MODEL=multilingual

# Optional: tokens the Laya classifier reads. The multilingual checkpoint
# defaults to 1024; raise it to 8192 for long documents.
LAYA_MAX_LEN=1024

# Optional: load the checkpoints into memory up front instead of lazily on the
# first prediction. Costs memory, saves the first-request latency.
LAYA_PRELOAD=false
